# Built with assistance from Oh My Pi (GLM 5.3).
FROM docker.io/library/ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ripgrep fd-find ca-certificates curl procps unzip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd
RUN (userdel -r ubuntu 2>/dev/null || true) && useradd -u 1000 -m -s /bin/bash agent

# uv — omp's Python eval tooling runs on it
RUN curl -LsSf https://astral.sh/uv/install.sh | env HOME=/home/agent sh \
    && chown -R agent:agent /home/agent/.local
ENV PATH="/home/agent/.local/bin:${PATH}"

# bun — no equivalent smaller install path; omp plugins/eval may use it
USER agent
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.14"
ENV BUN_INSTALL=/home/agent/.bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

# omp prebuilt binary (self-contained; no Node runtime needed)
ARG OMP_VERSION
USER root
RUN curl -fsSL \
      "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/omp-linux-x64" \
      -o /usr/local/bin/omp \
    && chmod +x /usr/local/bin/omp \
    && rm -rf /home/agent/.omp

COPY omp-pod-init /usr/local/bin/omp-pod-init
RUN chmod +x /usr/local/bin/omp-pod-init
RUN mkdir -p /home/agent/workspace && chown agent:agent /home/agent/workspace

USER agent
ENV PI_CONFIG_DIR=.omp HOME=/home/agent
WORKDIR /home/agent
ENTRYPOINT ["/usr/local/bin/omp-pod-init"]
